{
  "name": "easylock-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Web dashboard for easylock — runs easylock-core in-browser via WebAssembly",
  "scripts": {
    "wasm": "wasm-pack build ../easylock-wasm --target web --out-dir ../easylock-web/src/pkg --release",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview --port 4173"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.1"
  }
}
